# ── OIDF Conformance Suite (local) ────────────────────────────────────────
# Copy to infra/fapi-conformance/.env and fill in values. NEVER commit .env.

# Bearer token the suite uses for API authentication.
# Generate: openssl rand -hex 32
FAPI_SUITE_TOKEN=REPLACE_ME_WITH_RANDOM_HEX

# Host port the nginx proxy exposes (the suite's public URL in local mode).
FAPI_PROXY_PORT=8443

# Keystore password for the TLS cert inside the suite container.
# Must match certs/generate-fapi-certs.sh (-passout pass:sentinel-fapi).
FAPI_KEYSTORE_PASSWORD=sentinel-fapi

# Spring web log level (DEBUG helps triage plan failures).
FAPI_LOG_LEVEL=WARN

# ── Targets under test (must be running from the root docker-compose.yml) ─
# The suite container joins the root stack's network (sentinel-fapi2-stack),
# so it reaches Keycloak / Sentinel API by container name - NOT localhost.
# Keycloak's dev cert (infra/certs/keycloak.crt) carries the `keycloak` SAN,
# and the suite's JVM trusts the local CA via certs/truststore.p12.

# Keycloak issuer (realm sentinel-dast, HTTPS on container port 8443).
KEYCLOAK_ISSUER=https://keycloak:8443/realms/sentinel-dast

# Sentinel API (resource server for DPoP resource tests).
SENTINEL_API_URL=http://sentinel-api:8080

# ── Test plan ─────────────────────────────────────────────────────────────
FAPI_PLAN_NAME=fapi2-security-profile-dpop

# ── Keycloak admin (only used when FAPI_PROVISION_HOOK is set) ────────────
# NOTE: kcadm runs on the HOST, so it must use https://localhost:8443 and trust
# the local CA (see runbook: JAVA_TOOL_OPTIONS with certs/truststore.p12).
KC_ADMIN_URL=https://localhost:8443
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_REALM=sentinel-dast