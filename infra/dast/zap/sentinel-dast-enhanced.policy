# ZAP Scan Policy for Sentinel DAST gate (enhanced with Sentinel-specific attack vectors)
#
# Format: <rule-id>  <threshold>  <strength/click-se>  ON/OFF  (description)
# Active rules carry a strength column (LOW/MEDIUM/HIGH/INSANE);
# passive rules carry threshold only.
#
# Enhanced with Sentinel-specific attack vectors:
# - DPoP downgrade / proof replay / nonce bypass
# - ACR step-up bypass
# - FAPI 2.0 specific: PAR, algorithm confusion, audience validation
# - JWT confusion: RS256 vs PS256, kid injection

FORMAT: 1
TYPE       Default

# --- DISABLED: Noisy/irrelevant for JSON-only, cookieless, DPoP API ---
90027   1      OFF      (Cookie Slack Detector - API issues no cookies; cookieless by design)
10010   0      OFF      (Cookie No HttpOnly - no cookies issued)
10054   0      OFF      (SameSite Cookie Attribute - no cookies issued)
90033   0      OFF      (Loosely Scoped Cookie - no cookies issued)

# --- HEADERS: Verified by Nuclei baseline (sentinel-security-headers.yaml) ---
10020   0      OFF      (X-Frame-Options Header Scanner - sender headers verified by Nuclei baseline)
10021   0      OFF      (X-Content-Type-Options Header Missing - verified by Nuclei baseline)
10036   0      OFF      (HTTP Server Response Header - removed by design in Kestrel)

# --- ACTIVE SCAN TUNING: Payloads keep reasonable volume for throttled targets ---
10043   0      MEDIUM   ON   (JSON Content-Type header validation)
10045   0      LOW      ON   (Source Code Disclosure - low value but harmless)

# --- ENHANCED: Sentinel-specific attack vectors via custom payloads ---
# SQL Injection (EF Core fully parameterized; keep LOW for gray-box)
40018   0      LOW      ON   (SQL Injection - EF Core fully parameterized)

# XSS (API returns JSON; keep LOW for gray-box)
40012   0      LOW      ON   (Cross Site Scripting Reflected - JSON API, not rendered)

# SSRF (Sentinel has no outbound-fetch surface; keep LOW)
40035   0      LOW      ON   (Server Side Request Forgery)

# Mass Assignment (Explicit DTO allow-list; keep LOW)
40032   0      LOW      ON   (Mass Assignment)

# --- SENTINEL-SPECIFIC: Custom attack strength for FAPI 2.0 vectors ---
# These scanners are enabled with HIGH strength to ensure coverage of Sentinel-specific threats

# 40018 - SQL Injection: Enhanced with FAPI-specific payloads
# The policy file format doesn't support custom payloads directly.
# Custom payloads should be injected via ZAP's REST API or the automation plan.

# 40019 - Blind SQL Injection: Enhanced
# 40020 - SQL Injection (PostgreSQL): Enhanced
# 40021 - SQL Injection (MySQL): Enhanced
# 40022 - SQL Injection (Oracle): Enhanced
# 40023 - SQL Injection (MSSQL): Enhanced

# --- CUSTOM PAYLOADS FOR SENTINEL-SPECIFIC VECTORS ---
# These are defined as comments for reference; actual injection via automation plan or ZAP API

# DPoP DOWNGRADE / PROOF REPLAY / NONCE BYPASS
# Target: /v1/documents, /v1/profile, /v1/security-context, /v1/test/protected
# Method: Send requests without DPoP proof, with replayed proof, with stale nonce
# Expected: 401 Unauthorized with use_dpop_nonce challenge

# ACR STEP-UP BYPASS
# Target: /api/v1/finance/transfer (requires acr3)
# Method: Send requests with acr1/acr2 tokens, forged acr claim
# Expected: 401 Unauthorized / 403 Forbidden

# ALGORITHM CONFUSION (RS256 vs PS256)
# Target: Any DPoP-protected endpoint
# Method: Send JWT with alg=RS256 when PS256 is required
# Expected: 401 Unauthorized (algorithm not allowed)

# AUDIENCE VALIDATION BYPASS
# Target: Any DPoP-protected endpoint
# Method: Send token with wrong audience (not 'sentinel-api')
# Expected: 401 Unauthorized (invalid audience)

# JTI REPLAY
# Target: Any DPoP-protected endpoint
# Method: Reuse same access token (same jti) across requests
# Expected: 401 Unauthorized (jti replay cache hit)

# KEY INJECTION (kid)
# Target: Token endpoint / JWKS
# Method: Inject malicious kid pointing to attacker-controlled JWK
# Expected: 401 Unauthorized (kid not in trusted JWKS)

# PAR BYPASS
# Target: /protocol/openid-connect/par
# Method: Direct authorization request without PAR
# Expected: 400 Bad Request (PAR required)

# TOKEN BINDING BYPASS
# Target: Any DPoP-protected endpoint
# Method: Valid DPoP proof but mismatched ath (access token hash)
# Expected: 401 Unauthorized (ath mismatch)

# ACTIVE SCAN TUNING: Payloads keep reasonable volume so throttled targets
# (2 rps via the auth proxy) are still fully covered.
10043   0      MEDIUM   ON   (JSON Content-Type header validation)
10045   0      LOW      ON   (Source Code Disclosure - low value but harmless)