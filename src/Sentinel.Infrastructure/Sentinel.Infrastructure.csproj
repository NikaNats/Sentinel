<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>NikaNats.Sentinel.Infrastructure</PackageId>
    <Description>Core infrastructure and integration layer for Sentinel OAuth 2.0 &amp; OpenID Connect including cryptography, notifications, and security abstractions.</Description>
    <PackageTags>sentinel;infrastructure;cryptography;oauth2;openid;security;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fluid.Core" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- EF Core / Npgsql packages remain for SentinelDbContext + migrations only;
         concrete adapter ASSEMBLIES and cache/Redis dependencies are fully decoupled (ADR-2026-002). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Application\Sentinel.Application.csproj" />
    <ProjectReference Include="..\Sentinel.Domain\Sentinel.Domain.csproj" />
    <ProjectReference Include="..\Sentinel.Security.Abstractions\Sentinel.Security.Abstractions.csproj" />
    <!-- <ProjectReference Include="..\Sentinel.Security.Captcha\Sentinel.Security.Captcha.csproj" /> -->
    <!-- <ProjectReference Include="..\Sentinel.Security.Tokens\Sentinel.Security.Tokens.csproj" /> -->
    <ProjectReference Include="..\Sentinel.DPoP\Sentinel.DPoP.csproj" />
    <ProjectReference Include="..\Sentinel.Keycloak\Sentinel.Keycloak.csproj" />
    <ProjectReference Include="..\Sentinel.Security.Diagnostics\Sentinel.Security.Diagnostics.csproj" />
    <ProjectReference Include="..\Sentinel.Providers.Vault\Sentinel.Providers.Vault.csproj" />
  </ItemGroup>

</Project>
