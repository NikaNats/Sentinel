  "cards": [
    {
      "dot": "cyan",
      "title": "Refresh alternative",
      "items": [
        "Blank refresh token → 400 before Keycloak; caller DPoP is optional and the handler fills an absent proof",
        "Malformed or incompatible 2xx fails; compatible JSON without access_token can yield 200 with an empty token"
      ]
    },
    {
      "dot": "orange",
      "title": "Exchange alternative",
      "items": [
        "API gate requires external token, provider, code verifier, and DPoP before service invocation",
        "No reuse flag; null, provider error, or 2xx without access_token → 401"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence boundary",
      "items": [
        "Generated refresh proof omits ath",
        "Handler preserves supplied DPoP or fills an absent one",
        "clientIpHash is passed to refresh handling but unused"
      ]
    }
  ]
