  "cards": [
    {
      "dot": "emerald",
      "title": "Runtime path",
      "items": [
        "Client request enters the host-owned pipeline",
        "Pre-auth checks precede JWT authentication",
        "Post-auth binding uses the authenticated principal"
      ]
    },
    {
      "dot": "cyan",
      "title": "Dependency inversion",
      "items": [
        "Ports define stable security contracts",
        "Protocol engines use ports; adapters implement them",
        "The host selects concrete adapters at the composition root"
      ]
    },
    {
      "dot": "rose",
      "title": "State ownership",
      "items": [
        "Redis is the distributed security-state layer",
        "PostgreSQL is opt-in L3 for hybrid session revocation: a host must register the EF factory, TimeProvider, and final AddHybridSessionBlacklistCache decorator; the inspected reference host registers Redis-backed ports only",
        "Keycloak owns identity-provider state"
      ]
    }
  ]
