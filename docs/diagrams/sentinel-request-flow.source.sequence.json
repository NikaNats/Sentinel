      "label": "State"
    },
    {
      "id": "endpoint",
      "type": "backend",
      "label": "Endpoint"
    }
  ],
  "messages": [
    {
      "id": "request",
      "from": "client",
      "to": "host",
      "y": 180,
      "label": "HTTPS request + DPoP headers",
      "variant": "emphasis"
    },
    {
      "id": "forward",
      "from": "host",
      "to": "preauth",
      "y": 228,
      "label": "SecurityHeaders → Correlation → DPoP",
      "variant": "security"
    },
    {
      "id": "nonce",
      "from": "preauth",
      "to": "state",
      "y": 276,
      "label": "DPoP nonce / replay state",
      "variant": "security"
    },
    {
      "id": "auth",
      "from": "host",
      "to": "identity",
      "y": 324,
      "label": "JwtBearer authentication",
      "variant": "security"
    },
    {
      "id": "session",
      "from": "identity",
      "to": "state",
      "y": 372,
      "label": "Token validation: exp / sub / sid / JTI",
      "variant": "security"
    },
    {
      "id": "principal",
      "from": "identity",
      "to": "authorization",
      "y": 420,
      "label": "Authenticated principal",
      "variant": "security"
    },
    {
      "id": "authz",
      "from": "authorization",
      "to": "postauth",
      "y": 468,
      "label": "Endpoint policies + step-up",
      "variant": "security"
    },
    {
      "id": "invoke",
      "from": "postauth",
      "to": "endpoint",
      "y": 516,
      "label": "mTLS cnf binding; then ACR gate; execute",
      "variant": "emphasis"
    },
    {
      "id": "response",
      "from": "endpoint",
      "to": "client",
      "y": 564,
      "label": "Downstream result; 2xx/3xx best-effort candidate nonce",
      "variant": "return"
    },
    {
      "id": "failure",
      "from": "preauth",
      "to": "client",
      "y": 612,
      "label": "401 / 503 failure branch",
      "variant": "return",
      "note": "Proof acceptance is distinct from the final HTTP outcome."
    }
  ],
  "activations": [
    {
      "participant": "host",
      "from": 180,
      "to": 700,
      "type": "backend"
    },
    {
      "participant": "preauth",
      "from": 228,
      "to": 500,
