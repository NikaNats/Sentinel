    },
    {
      "participant": "identity",
      "from": 276,
      "to": 420,
      "type": "security"
    },
    {
      "participant": "authorization",
      "from": 372,
      "to": 516,
      "type": "security"
    },
    {
      "participant": "postauth",
      "from": 420,
      "to": 564,
      "type": "security"
    },
    {
      "participant": "endpoint",
      "from": 516,
      "to": 650,
      "type": "backend"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Ordered host path",
      "items": [
        "Request enters the host, then pre-authentication security, authentication, authorization, and post-authentication binding/ACR",
        "Token revocation/replay validation occurs inside JwtBearer OnTokenValidated before authorization",
        "mTLS validates cnf binding; AcrValidationMiddleware separately requires acr for authenticated requests"
      ]
    },
    {
      "dot": "amber",
      "title": "Response semantics",
      "items": [
        "Proof acceptance is distinct from the final endpoint response",
        "2xx/3xx attempts best-effort nonce rotation; the OnStarting callback suppresses state-store failures",
        "Synchronous DPoP state failures return 503; later failures follow their own host/response path"
      ]
    },
    {
      "dot": "rose",
      "title": "Evidence boundary",
      "items": [
        "The reference host is a test harness; this is source-inspected pipeline order, not live-service proof",
        "Open DPoP, JTI, and refresh findings remain review items",
        "AOT and live-service behavior remain unverified"
      ]
    }
  ]
}
